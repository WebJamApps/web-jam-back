{
  "name": "web-jam-back",
  "version": "2.39.2",
  "description": "web-jam.com",
  "type": "module",
  "main": "build/src/index.js",
  "engines": {
    "node": "26.x"
  },
  "files": [
    "src/"
  ],
  "license": "MIT",
  "imports": {
    "#src/*": "./build/src/*",
    "#lib/*": "./build/src/lib/*"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "shell-quote": "^1.12.0",
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "ts-api-utils": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "rmrf": "rimraf build && rimraf JaMmusic && rimraf coverage",
    "dev": "rimraf build && tsc && npm run copy:assets && concurrently --raw \"npm:ts-start\" \"npm:ts-watch\"",
    "copy:assets": "node scripts/copy-assets.mjs",
    "seed:outreach": "node scripts/seed-outreach.mjs",
    "migrate:target-weekend": "node build/src/scripts/migrate-target-weekend.js",
    "migrate:gig-venue-id": "node build/src/scripts/migrate-gig-venue-id.js",
    "migrate:drop-in-scope": "node build/src/scripts/migrate-drop-in-scope.js",
    "migrate:drop-contact-verified": "node build/src/scripts/migrate-drop-contact-verified.js",
    "migrate:drop-do-not-contact": "node build/src/scripts/migrate-drop-do-not-contact.js",
    "migrate:drop-venue-legacy-fields": "node build/src/scripts/migrate-drop-venue-legacy-fields.js",
    "migrate:backfill-family-nearby": "node build/src/scripts/backfill-family-nearby.js",
    "migrate:clean-city": "node build/src/scripts/migrate-clean-city.js",
    "migrate:clean-website": "node build/src/scripts/migrate-clean-website.js",
    "migrate:josh-to-jammusic": "node build/src/scripts/migrate-josh-to-jammusic.js",
    "apply-venue-pay-figures": "node build/src/scripts/apply-venue-pay-figures.js",
    "restore:backup": "node scripts/restore-backup.mjs",
    "refresh:map-listings": "node scripts/refresh-map-listings.mjs",
    "ts-watch": "tsc -w",
    "ts-start": "DEBUG=web-jam-back:* node --watch --trace-deprecation build/src/index.js",
    "installglobals": "npm install -g npm@latest && npm install -g snyk",
    "build:front": "./postinstallJaM.sh && rimraf ./JaMmusic/src && rimraf ./JaMmusic/test",
    "postinstall": "npm run rmrf && tsc -p tsconfig.prod.json && npm run copy:assets && npm run build:front",
    "start": "node build/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.prod.json && tsc --noEmit",
    "cleanup": "rimraf yarn.lock && rimraf package-lock.json && rimraf node_modules && rimraf JaMmusic && rimraf build && rimraf coverage",
    "cleaninstall": "npm install -g npm@latest && npm install -g rimraf && npm run cleanup && npm cache clean --force && npm install",
    "smoketest": "npm run cleanup && npm install --omit=dev",
    "node:debug": "node --inspect-brk index.js",
    "jscpd": "jscpd src",
    "lint:openapi": "redocly lint openapi.json",
    "test": "npm run lint:openapi && eslint ./src && npm run jscpd && npm run typecheck && rimraf coverage && npm run test:unit",
    "test:lint": "eslint ./src --fix",
    "test:local": "npm run lint:openapi && npm run test:lint && npm run typecheck && rimraf coverage && npm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:all": "npm run test:local",
    "seed:second-pitch-templates": "node scripts/seed-second-pitch-templates.mjs",
    "migrate:song-catalog": "node build/src/scripts/migrate-song-catalog.js",
    "load:song-catalog": "node build/src/scripts/load-song-catalog.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/WebJamApps/web-jam-back.git"
  },
  "author": "HandlersAndKickers <>",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/express-sslify": "^1.2.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "cors": "^2.8.6",
    "csvtojson": "^2.0.14",
    "debug": "^4.4.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-sslify": "^1.2.0",
    "helmet": "^8.3.0",
    "jwt-simple": "^0.6.1",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "nodemailer": "^10.5.0",
    "rimraf": "^6.1.4",
    "sharp": "^0.35.5",
    "snyk": "^1.1308.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.77.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "snyk": true
}
